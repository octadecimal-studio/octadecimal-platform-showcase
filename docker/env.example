# Octadecimal Studio - Docker Environment Variables
# Skopiuj do .env i dostosuj wartości

# Porty aplikacji
APP_PORT=80
APP_SSL_PORT=443

# MySQL
DB_ROOT_PASSWORD=<DB_ROOT_PASSWORD>
DB_DATABASE=octadecimal
DB_USERNAME=octadecimal
DB_PASSWORD=<DB_PASSWORD>
DB_PORT=3306

# Redis
REDIS_PORT=6379

# Environment
APP_ENV=production
