{
  "name": "@octadecimal/site-builder",
  "version": "1.0.0",
  "description": "Automatyczne narzędzie do budowy i wdrażania stron z szablonów HTML na VPS z integracją Strapi CMS",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "site-builder": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "deploy": "node dist/cli.js deploy",
    "test": "node dist/cli.js --help"
  },
  "keywords": [
    "site-builder",
    "strapi",
    "nextjs",
    "deployment",
    "automation",
    "vps",
    "ovh",
    "dns",
    "ssl"
  ],
  "author": "Octadecimal Studio",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@octadecimal/template-analyzer": "file:../template-analyzer",
    "chalk": "^5.3.0",
    "cheerio": "^1.1.2",
    "commander": "^12.1.0",
    "fs-extra": "^11.2.0",
    "inquirer": "^13.2.0",
    "node-fetch": "^3.3.2",
    "ora": "^8.1.1",
    "ovh": "latest",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.10.5",
    "@types/ssh2": "^1.15.1",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
